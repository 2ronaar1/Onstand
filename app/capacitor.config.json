{
  "appId": "de.onstand.app",
  "appName": "Onstand",
  "webDir": "www",
  "backgroundColor": "#0A0C0F",
  "server": {
    "url": "https://2ronaar1.github.io/Onstand/onstand.html",
    "cleartext": false,
    "errorPath": "index.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A0C0F",
    "appendUserAgent": "OnstandApp",
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}